# ---- MySQL（metric 库，只读账号即可）----
DB_HOST=rm-xxxxxxxx.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_USER=big_data_read
DB_PASSWORD=changeme
DB_NAME=metric
DB_POOL_SIZE=6

# ---- MCP 服务监听 ----
MCP_HOST=0.0.0.0
MCP_PORT=8600
MCP_PATH=/mcp

# ---- 鉴权：1=校验 base_from_mcp_api_key 表；0=关闭（仅内网调试）----
MCP_AUTH_REQUIRED=1

# ---- 调用日志：0=仅本地 logs/invoke_log.jsonl；1=同时写 base_from_mcp_invoke_log（需可写账号）----
MCP_LOG_TO_DB=0
MCP_LOG_DIR=logs

# ---- 新鲜度逾期阈值（天）----
FRESHNESS_STALE_DAYS=10
